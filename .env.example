# Save Point Project Hub · © Save Point Limited
# Copy to .env (git-ignored). Never commit real tokens.

# Discord Developer Portal → your app → Bot → Reset Token
DISCORD_TOKEN=
# GitHub fine-grained PAT, read-only: Contents, Metadata, Pull requests, Issues
GITHUB_TOKEN=
# The address teammates use to reach the docsync API, shown by /token
PUBLIC_API_URL=http://your-server:8080
# The server's Tailscale IP. The docsync API only listens on this address.
TAILSCALE_IP=
